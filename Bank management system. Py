account = {}

while True:
    print("\n===== BANK ACCOUNT MANAGEMENT SYSTEM =====")
    print("1. Create Account")
    print("2. Deposit Money")
    print("3. Withdraw Money")
    print("4. Check Balance")
    print("5. View Account Details")
    print("6. Exit")

    choice = input("Enter your choice (1-6): ")

    if choice == "1":
        name = input("Enter account holder's name: ")
        account_number = input("Enter account number: ")

        if account_number in account:
            print("Account already exists!")
        else:
            balance = float(input("Enter opening balance: "))
            account[account_number] = {
                "name": name,
                "balance": balance
            }
            print("Account created successfully!")

    elif choice == "2":
        account_number = input("Enter account number: ")

        if account_number in account:
            amount = float(input("Enter amount to deposit: "))
            account[account_number]["balance"] += amount
            print("Deposit successful!")
            print("New balance:", account[account_number]["balance"])
        else:
            print("Account not found!")

    elif choice == "3":
        account_number = input("Enter account number: ")

        if account_number in account:
            amount = float(input("Enter amount to withdraw: "))

            if amount <= account[account_number]["balance"]:
                account[account_number]["balance"] -= amount
                print("Withdrawal successful!")
                print("New balance:", account[account_number]["balance"])
            else:
                print("Insufficient balance!")
        else:
            print("Account not found!")

    elif choice == "4":
        account_number = input("Enter account number: ")

        if account_number in account:
            print("Current Balance:", account[account_number]["balance"])
        else:
            print("Account not found!")

    elif choice == "5":
        account_number = input("Enter account number: ")

        if account_number in account:
            print("\n===== ACCOUNT DETAILS =====")
            print("Account Holder:", account[account_number]["name"])
            print("Account Number:", account_number)
            print("Balance:", account[account_number]["balance"])
        else:
            print("Account not found!")

    elif choice == "6":
        print("Thank you for using the Bank Account Management System.")
        break

    else:
        print("Invalid choice! Please enter a number between 1 and 6.")
